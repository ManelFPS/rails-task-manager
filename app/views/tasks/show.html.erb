<h1><%= @task.title%></h1>
<p>Details: <%=@task.details%></p>
<p>Is it done?: <%=@task.completed%>
<p><%= link_to "Delete", task_path(@task), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete?" }  %></p>
<p><%=link_to "Back to list", tasks_path, class: "text-decoration-none"%></p>
